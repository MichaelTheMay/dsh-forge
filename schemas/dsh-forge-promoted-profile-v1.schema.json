{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Forge promoted profile pointer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "install_id", "package_id", "tree_id", "profile", "home", "previous_install_id", "promoted_at"],
  "properties": {
    "schema": {"const": "dsh-forge.promoted-profile/v1"},
    "install_id": {"type": "string", "pattern": "^install_[0-9a-f]{20}$"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "tree_id": {"type": "string", "pattern": "^tree_[0-9a-f]{12}$"},
    "profile": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "home": {"type": "string", "minLength": 1},
    "previous_install_id": {"type": ["string", "null"]},
    "promoted_at": {"type": "string", "format": "date-time"}
  }
}
