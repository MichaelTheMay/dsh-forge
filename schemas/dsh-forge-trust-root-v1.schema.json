{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Forge local package trust root v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "root_id", "expires_at", "threshold", "keys"],
  "properties": {
    "schema": {"const": "dsh-forge.trust-root/v1"},
    "root_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "threshold": {"type": "integer", "minimum": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "algorithm", "public_key_pem", "status"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "algorithm": {"const": "ed25519"},
          "public_key_pem": {"type": "string", "maxLength": 8192},
          "status": {"enum": ["active", "revoked"]}
        }
      }
    }
  }
}
