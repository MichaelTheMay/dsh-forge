{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-forge.dev/schemas/dsh-forge-quarantine-receipt-v1.schema.json",
  "title": "DSH Forge quarantine acquisition receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "payload_digest",
    "composition_digest",
    "valid_signers",
    "threshold",
    "acquired_at",
    "quarantine_root",
    "limits",
    "artifacts",
    "credentials_forwarded",
    "archives_extracted",
    "installation_authorized",
    "execution_authorized"
  ],
  "properties": {
    "schema": {"const": "dsh-forge.quarantine-receipt/v1"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "description", "license", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "description": {"type": "string", "maxLength": 512},
        "license": {"type": "string", "minLength": 1, "maxLength": 128},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composition_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "valid_signers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "threshold": {"type": "integer", "minimum": 1, "maximum": 32},
    "acquired_at": {"type": "string", "format": "date-time"},
    "quarantine_root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_artifact_bytes", "max_total_bytes", "artifact_timeout_seconds", "total_timeout_seconds"],
      "properties": {
        "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 8589934592},
        "artifact_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300},
        "total_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 3600}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plugin_id",
          "source_kind",
          "source_name",
          "source_version",
          "signed_integrity",
          "bytes",
          "content_sha256",
          "original_url",
          "final_url",
          "redirect_chain",
          "object",
          "reused"
        ],
        "properties": {
          "plugin_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
          "source_kind": {"enum": ["npm", "mcpb", "github_archive"]},
          "source_name": {"type": "string", "minLength": 1, "maxLength": 214},
          "source_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "signed_integrity": {"type": "string", "minLength": 1, "maxLength": 256},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
          "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "original_url": {"type": "string", "format": "uri", "maxLength": 2048},
          "final_url": {"type": "string", "format": "uri", "maxLength": 2048},
          "redirect_chain": {
            "type": "array",
            "maxItems": 3,
            "items": {"type": "string", "format": "uri", "maxLength": 2048}
          },
          "object": {"type": "string", "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}/artifact$"},
          "reused": {"type": "boolean"}
        }
      }
    },
    "credentials_forwarded": {"const": false},
    "archives_extracted": {"const": false},
    "installation_authorized": {"const": false},
    "execution_authorized": {"const": false}
  }
}
