{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-forge.dev/schemas/dsh-forge-catalog-sources-v1.schema.json",
  "title": "DSH Forge bounded catalog sources and recipes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "captured_at", "directories", "recipes"],
  "properties": {
    "schema": {"const": "dsh-forge.catalog-sources/v1"},
    "captured_at": {"type": "string", "format": "date-time"},
    "directories": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "url", "kind", "revision", "trust", "coverage"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "url": {"type": "string", "format": "uri", "maxLength": 2048},
          "kind": {"enum": ["normalized_json", "curated_repository", "official_discussions", "registry"]},
          "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
          "trust": {"enum": ["lead_only", "authoritative_metadata"]},
          "coverage": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "recipes": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slug", "name", "summary", "kind", "rank", "featured", "publisher", "components", "taxonomy", "compatibility", "risk", "directory_ids"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 96},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512},
          "kind": {"enum": ["plugin_stack", "single_plugin"]},
          "rank": {"type": "integer", "minimum": 1, "maximum": 10000},
          "featured": {"type": "boolean"},
          "publisher": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "kind"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "kind": {"enum": ["curator", "community"]}
            }
          },
          "components": {
            "type": "array", "minItems": 1, "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact_id", "role"],
              "properties": {
                "artifact_id": {"type": "string", "pattern": "^github:[1-9][0-9]*$"},
                "role": {"type": "string", "minLength": 1, "maxLength": 160}
              }
            }
          },
          "taxonomy": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 96}},
          "compatibility": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "harness_versions", "node", "surfaces", "summary"],
            "properties": {
              "status": {"enum": ["declared", "unknown", "incompatible"]},
              "harness_versions": {
                "type": "array", "maxItems": 32, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?(?:\\+[0-9A-Za-z][0-9A-Za-z.-]*)?$"}
              },
              "node": {"type": ["string", "null"], "maxLength": 64},
              "surfaces": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["web", "headless", "tui", "mcp"]}},
              "summary": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "risk": {
            "type": "object", "additionalProperties": false,
            "required": ["level", "permissions", "notes"],
            "properties": {
              "level": {"enum": ["low", "medium", "medium-high", "high", "critical"]},
              "permissions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
              "notes": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "directory_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}}
        }
      }
    }
  }
}
