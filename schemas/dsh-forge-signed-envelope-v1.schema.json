{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSSE envelope for a DSH Forge package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payloadType", "payload", "signatures"],
  "properties": {
    "payloadType": {"const": "application/vnd.dsh-forge.package.v1+json"},
    "payload": {"type": "string", "contentEncoding": "base64", "maxLength": 2097152},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyid", "sig"],
        "properties": {
          "keyid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sig": {"type": "string", "contentEncoding": "base64", "maxLength": 4096}
        }
      }
    }
  }
}
