{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-forge.dev/schemas/dsh-forge-catalog-package-v1.schema.json",
  "title": "DSH Forge catalog package metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "slug", "name", "summary", "kind", "rank", "featured",
    "publisher", "components", "taxonomy", "compatibility", "license", "risk",
    "provenance", "verification", "acquisition", "page", "updated_at"
  ],
  "properties": {
    "schema": {"const": "dsh-forge.catalog-package/v1"},
    "id": {"type": "string", "pattern": "^catalog-package:[a-z0-9][a-z0-9-]{1,63}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 96},
    "summary": {"type": "string", "minLength": 1, "maxLength": 512},
    "kind": {"enum": ["plugin_stack", "single_plugin"]},
    "rank": {"type": "integer", "minimum": 1, "maximum": 10000},
    "featured": {"type": "boolean"},
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["curator", "community"]}
      }
    },
    "components": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "role", "package", "repository", "compatibility"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^github:[1-9][0-9]*$"},
          "role": {"type": "string", "minLength": 1, "maxLength": 160},
          "package": {
            "type": "object", "additionalProperties": false,
            "required": ["registry", "name", "version", "integrity", "url"],
            "properties": {
              "registry": {"enum": ["npm", "mcpb"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 214},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?(?:\\+[0-9A-Za-z][0-9A-Za-z.-]*)?$"},
              "integrity": {"type": "string", "pattern": "^(sha512-[A-Za-z0-9+/]+={0,2}|sha256-[0-9a-f]{64})$"},
              "url": {"type": "string", "format": "uri", "maxLength": 2048}
            }
          },
          "repository": {
            "type": "object", "additionalProperties": false,
            "required": ["full_name", "url", "commit"],
            "properties": {
              "full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          },
          "compatibility": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "taxonomy": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 96}
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "harness_versions", "node", "surfaces", "summary"],
      "properties": {
        "status": {"enum": ["declared", "unknown", "incompatible", "sandbox_verified"]},
        "harness_versions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
        "node": {"type": ["string", "null"], "maxLength": 64},
        "surfaces": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["web", "headless", "tui", "mcp"]}},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "expressions"],
      "properties": {
        "status": {"enum": ["reported", "mixed", "unknown"]},
        "expressions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "permissions", "notes"],
      "properties": {
        "level": {"enum": ["low", "medium", "medium-high", "high", "critical"]},
        "permissions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 96}},
        "notes": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["directory_ids", "authoritative_sources", "claims_verified"],
      "properties": {
        "directory_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}},
        "authoritative_sources": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 2048}},
        "claims_verified": {"const": false}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata_reviewed", "artifacts_acquired", "installed", "executed", "sandbox_verified"],
      "properties": {
        "metadata_reviewed": {"type": "boolean"},
        "artifacts_acquired": {"const": false},
        "installed": {"const": false},
        "executed": {"const": false},
        "sandbox_verified": {"const": false}
      }
    },
    "acquisition": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "label", "status", "reason"],
      "properties": {
        "enabled": {"const": false},
        "label": {"const": "Acquire verified bytes"},
        "status": {"const": "requires_signed_dsse"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["route"],
      "properties": {"route": {"type": "string", "pattern": "^#packages/[a-z0-9][a-z0-9-]{1,63}$"}}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
